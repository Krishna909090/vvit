  name      String 
  type      String 
  rooms     HostelRoom[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean @default(false)

  @@index([hostelId])
  @@index([isDeleted])
}

