generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()"))
  name                String?
  email               String?                  @unique
  phone               String?                  @unique
  role                String?
  createdAt           DateTime?                @default(now())
  updatedAt           DateTime                 @updatedAt
  createdBy           String?
  updatedBy           String?
  isDeleted           Boolean?                 @default(false)
  password            String?
  tokenVersion        Int                      @default(0)
  agentCommissions    AgentCommission[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  studentProfile      Student?                 @relation("StudentUser")
  userGroups          UserGroup[]
  otps                UserOtp[]
  permissionOverrides UserPermissionOverride[]
  proProfile          PRO?                     @relation("ProUser")
}

model UserOtp {
  id           String    @id @default(dbgenerated("gen_random_uuid()"))
  userId       String
  type         String
  otpHash      String
  otpEncrypted String?
  expiresAt    DateTime
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5)
  used         Boolean?  @default(false)
  createdAt    DateTime? @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?
  user         User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([userId, type, used])
}

model School {
  id          String       @id @default(dbgenerated("gen_random_uuid()"))
  name        String
  code        String
  createdAt   DateTime?    @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   String?
  updatedBy   String?
  isDeleted   Boolean?     @default(false)
  departments Department[]
}

model Department {
  id        String    @id @default(dbgenerated("gen_random_uuid()"))
  name      String
  code      String
  schoolId  String?
  createdAt DateTime? @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean?  @default(false)
  courses   Course[]
  school    School?   @relation(fields: [schoolId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Course {
  id               String             @id @default(dbgenerated("gen_random_uuid()"))
  code             String?
  name             String
  departmentId     String
  createdAt        DateTime?          @default(now())
  updatedAt        DateTime           @updatedAt
  createdBy        String?
  updatedBy        String?
  isDeleted        Boolean?           @default(false)
  degree           String?
  // OMR ID = physical OMR scan-sheet identifier. Unique across all courses.
  // Nullable: courses without OMR scanning don't need one — Postgres allows
  // multiple NULLs under a unique index, so unset courses never collide.
  omrId            Int?               @unique
  department       Department         @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feeStructures    FeeStructure[]
  studentsPref1    Student[]          @relation("Pref1")
  studentsPref2    Student[]          @relation("Pref2")
  studentsPref3    Student[]          @relation("Pref3")
  allottedStudents StudentAdmission[] @relation("AllottedCourse")
  waitingList      WaitingList[]
  capacities       CourseCapacity[]
  batches          Batch[]
  subjects         Subject[]
}

model CourseCapacity {
  id              String        @id @default(dbgenerated("gen_random_uuid()"))
  courseId        String
  academicYearId  String
  totalSeats      Int
  filledSeats     Int           @default(0)
  createdAt       DateTime?     @default(now())
  updatedAt       DateTime      @updatedAt
  createdBy       String?
  updatedBy       String?
  course          Course        @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear    AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([courseId, academicYearId])
  @@index([academicYearId])
}

model Batch {
  id               String     @id @default(dbgenerated("gen_random_uuid()"))
  name             String
  startDate        DateTime
  endDate          DateTime
  courseId         String
  // The academic year the batch (cohort) was admitted in — its entry year.
  // Nullable for backward compatibility with batches created before this field;
  // new batches always set it (createBatch requires it).
  academicYearId   String?
  createdAt        DateTime?  @default(now())
  updatedAt        DateTime   @updatedAt
  createdBy        String?
  updatedBy        String?
  isDeleted        Boolean?   @default(false)
  course           Course        @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear     AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sections         Section[]

  @@index([academicYearId])
}

model Section {
  id        String              @id @default(dbgenerated("gen_random_uuid()"))
  name      String
  batchId   String
  createdAt DateTime?           @default(now())
  updatedAt DateTime            @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean?            @default(false)
  batch     Batch               @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students  StudentEnrollment[]
}

model AcademicYear {
  id                String              @id @default(dbgenerated("gen_random_uuid()"))
  code              String
  startDate         DateTime
  endDate           DateTime
  isActive          Boolean?            @default(true)
  isLocked          Boolean?            @default(false)
  createdAt         DateTime?           @default(now())
  updatedAt         DateTime            @updatedAt
  createdBy         String?
  updatedBy         String?
  isDeleted         Boolean?            @default(false)
  feeStructures     FeeStructure[]
  feeStructuresAsEntry    FeeStructure[]       @relation("FeeStructureEntryYear")
  studentAdmissions       StudentAdmission[]   @relation("AdmissionCurrentYear")
  studentAdmissionsEntry  StudentAdmission[]   @relation("AdmissionEntryYear")
  studentAdmissionsCohort StudentAdmission[]   @relation("AdmissionFeeCohortYear")
  enrollments       StudentEnrollment[]
  studentFeeDemands StudentFeeDemand[]
  payments          Payment[]
  ledgerEntries     StudentLedger[]
  feeCorrections    FeeCorrection[]
  hostelPriceCategories     HostelPriceCategory[]
  transportYearlyPrices     TransportRouteYearlyPrice[]
  courseCapacities          CourseCapacity[]
  semesterMarks             SemesterMark[]
  classAttendance           ClassAttendance[]
  studentDocuments          StudentDocument[]
  studentScholarships       StudentScholarship[]
  hostelAllocations         HostelAllocation[]
  transportAllocations      TransportAllocation[]
  batches                   Batch[]
}

model StudentEnrollment {
  id              String            @id @default(dbgenerated("gen_random_uuid()"))
  studentId       String
  sectionId       String
  rollNumber      String
  currentSemester Int?              @default(1)
  yearOfStudy     Int?              @default(1)
  academicYearId  String
  status          EnrollmentStatus? @default(ACTIVE)
  createdAt       DateTime?         @default(now())
  updatedAt       DateTime          @updatedAt
  createdBy       String?
  updatedBy       String?
  academicYear    AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  section         Section           @relation(fields: [sectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student         Student           @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([studentId, academicYearId])
  @@unique([academicYearId, rollNumber], map: "StudentEnrollment_year_roll_unique")
  @@index([studentId])
  @@index([academicYearId])
  @@index([status])
}

model Student {
  id                        String                  @id @default(dbgenerated("gen_random_uuid()"))
  applicationId             String?                 @unique
  name                      String
  fatherName                String
  motherName                String
  gender                    String
  dob                       DateTime
  phone                     String
  email                     String?                 @unique
  aadharNumber              String
  category                  String
  country                   String
  address                   String
  address2                  String?
  city                      String
  state                     String
  pincode                   String
  profilePhotoUrl           String?
  source                    AdmissionSource?        @default(WEBSITE)
  quotaType                 QuotaType?              @default(MANAGEMENT)
  applicationMode           ApplicationMode?        @default(ONLINE)
  isOffline                 Boolean?                @default(false)
  isKycVerified             Boolean?                @default(false)
  pref1                     String?
  pref2                     String?
  pref3                     String?
  userId                    String?                 @unique
  degreeType                String?
  createdAt                 DateTime?               @default(now())
  updatedAt                 DateTime                @updatedAt
  createdBy                 String?
  updatedBy                 String?
  academicQualifications    AcademicQualification[]
  agentCommissions          AgentCommission[]
  attendanceRecords         AttendanceRecord[]
  cancellationRequests      CancellationRequest[]
  convenorDetails           ConvenorAdmission?
  courseChangeLogs          CourseChangeLog[]
  courseChangeRequests      CourseChangeRequest[]
  discountRequests          DiscountRequest[]
  fileUploads               FileUpload[]
  hallTickets               HallTicket[]
  hostelAllocation          HostelAllocation?
  payments                  Payment[]
  scholarshipAllocation     ScholarshipAllocation?
  seatAllocations           SeatAllocation[]
  serviceChangeRequests     ServiceChangeRequest[]
  pref1Course               Course?                 @relation("Pref1", fields: [pref1], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pref2Course               Course?                 @relation("Pref2", fields: [pref2], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pref3Course               Course?                 @relation("Pref3", fields: [pref3], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                      User?                   @relation("StudentUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  admissionDetails          StudentAdmission?
  documents                 StudentDocument[]
  enrollments               StudentEnrollment[]
  examDetails               StudentExam?
  feeDemands                StudentFeeDemand[]
  ledgerEntries             StudentLedger[]
  studentScholarship        StudentScholarship?
  transportAllocation       TransportAllocation?
  waitingListEntries        WaitingList[]
  feeCorrections            FeeCorrection[]
  accommodationPricing      StudentAccommodationPricing[]
  semesterMarks             SemesterMark[]
  classAttendance           ClassAttendance[]

  proId                     String?
  pro                       PRO?                    @relation(fields: [proId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([phone])
  @@index([degreeType])
  @@index([createdAt])
  @@index([proId])
}

model ConvenorAdmission {
  id             String    @id @default(dbgenerated("gen_random_uuid()"))
  studentId      String    @unique
  rank           String?
  hallTicketNo   String?
  allotmentOrder String?
  councilId      String?
  category       String?
  joiningReport  String?
  createdAt      DateTime? @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  student        Student   @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model DataImportMapping {
  id        String     @id @default(dbgenerated("gen_random_uuid()"))
  name      String     @unique
  type      ImportType
  mapping   Json
  isActive  Boolean?   @default(true)
  createdAt DateTime?  @default(now())
  updatedAt DateTime   @updatedAt
  createdBy String?
  updatedBy String?
}

model StudentExam {
  id               String    @id @default(dbgenerated("gen_random_uuid()"))
  studentId        String    @unique
  hallTicketUrl    String?
  testDate         DateTime?
  testCenter       String?
  examAttended     Boolean?  @default(false)
  examScore        Float?
  isQualified      Boolean?  @default(false)
  examSlotId       String?
  class12Aggregate Float?
  jeePercentile    Float?
  satScore         Float?
  vvitPercentile   Float?
  createdAt        DateTime? @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?
  examSlot         ExamSlot? @relation(fields: [examSlotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student          Student   @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model StudentAdmission {
  id                String             @id @default(dbgenerated("gen_random_uuid()"))
  studentId         String             @unique
  status            AdmissionStatus?   @default(REGISTERED)
  totalFee          Float?             @default(0)
  paidFee           Float?             @default(0)
  feeStatus         FeeStatus?         @default(PENDING)
  accommodationType AccommodationType? @default(NONE)
  hostelType        HostelType?
  hostelId          String?
  transportRouteId  String?
  roomNumber        String?
  allottedCourseId  String?
  seatAllotedBy     String?
  seatAllottedAt    DateTime?
  createdAt         DateTime?          @default(now())
  updatedAt         DateTime           @updatedAt
  hostelPaymentMode HostelPaymentMode? @default(YEARWISE)
  academicYearId    String?

  // Lateral / back-dated admission tracking. Frozen at admission time —
  // unlike `academicYearId` (which advances on year promotion), these stay
  // immutable for cohort reporting (e.g., "lateral-entry batch of 2025-26").
  entryType                AdmissionEntryType? @default(REGULAR)
  entryYearOfStudy         Int?                @default(1) // year-of-study at admission moment
  entryAcademicYearId      String?                          // academicYear at admission moment
  feeCohortAcademicYearId  String?                          // which cohort's fee schedule applies (for FRESH = entryAcademicYearId; for LATERAL = the batch they slot into)
  instituteCode            String?                          // 'VVIG' (default for most batches) / 'VVITU' / 'VVITPU' (2025-26 batch only) — picks which institute's fee schedule applies
  entryReason              String?                          // free-text: e.g. "Diploma → BTech 2nd year"
  isBackdated              Boolean?            @default(false) // admin-flagged for back-entry

  academicYear             AcademicYear?      @relation("AdmissionCurrentYear", fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entryAcademicYear        AcademicYear?      @relation("AdmissionEntryYear",   fields: [entryAcademicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feeCohortAcademicYear    AcademicYear?      @relation("AdmissionFeeCohortYear", fields: [feeCohortAcademicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  allottedCourse    Course?            @relation("AllottedCourse", fields: [allottedCourseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hostel            Hostel?            @relation(fields: [hostelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student           Student            @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transportRoute    TransportRoute?    @relation(fields: [transportRouteId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entryType])
  @@index([entryAcademicYearId])
}

model StudentDocument {
  id          String                 @id @default(dbgenerated("gen_random_uuid()"))
  studentId   String
  documentKey String
  url         String
  status      StudentDocumentStatus? @default(PENDING)
  remarks     String?
  verifiedBy  String?
  // Optional year tag. NULL = program-wide / legacy document (pre-year-aware).
  // NOTE: the @@unique below is still (studentId, documentKey) — so same-key
  // year-wise documents do NOT yet coexist. To allow that, alter the unique to
  // include academicYearId (touches the 8 `studentId_documentKey` call sites).
  academicYearId String?
  isDeleted   Boolean?               @default(false)
  createdAt   DateTime?              @default(now())
  updatedAt   DateTime               @updatedAt
  createdBy   String?
  updatedBy   String?
  student     Student                @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear AcademicYear?         @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([studentId, documentKey])
  @@index([academicYearId])
}

model Hostel {
  id                  String             @id @default(dbgenerated("gen_random_uuid()"))
  name                String
  type                String?
  wardenName          String?
  floors              Int?
  totalRooms          Int?
  photoUrl            String?
  // Bank routing — different hostels can route fees to different bank accounts
  accommodationBank   String?            // 'TRUST' | 'LLP'
  messBank            String?            @default("LLP")
  laundryBank         String?
  registrationBank    String?
  isDeleted           Boolean?           @default(false)
  createdAt           DateTime?          @default(now())
  updatedAt           DateTime           @updatedAt
  createdBy           String?
  updatedBy           String?
  rooms               HostelRoom[]       @relation("HostelRooms")
  studentAdmissions   StudentAdmission[]
}

model HostelRoom {
  id                String       @id @default(dbgenerated("gen_random_uuid()"))
  hostelId          String
  floor             Int
  number            String
  capacity          Int
  type              String
  isDeleted         Boolean?     @default(false)
  createdAt         DateTime?    @default(now())
  updatedAt         DateTime     @updatedAt
  createdBy         String?
  updatedBy         String?
  beds              HostelBed[]
  hostel            Hostel       @relation("HostelRooms", fields: [hostelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model HostelPriceCategory {
  id                 String         @id @default(dbgenerated("gen_random_uuid()"))
  sharing            Int
  roomType           HostelRoomType

  // Year-aware pricing. NULL = legacy "applies to any year" (backward compat).
  // New rows should always set academicYearId so each year's prices are isolated.
  academicYearId     String?
  academicYear       AcademicYear?  @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Yearwise (Single Instalment) prices
  accommodationYearwise Float?      @default(0)
  messYearwise          Float?      @default(0)
  laundryYearwise       Float?      @default(0)

  // Semwise (Two Instalment) prices — total amount paid across both instalments
  accommodationSemwise  Float?      @default(0)
  messSemwise           Float?      @default(0)
  laundrySemwise        Float?      @default(0)

  // One-time, non-refundable
  registrationFee       Float?      @default(0)

  // Free-form for future extensions (e.g. promotional discounts)
  metadata              Json?

  isActive              Boolean?    @default(true)
  createdAt             DateTime?   @default(now())
  updatedAt             DateTime    @updatedAt
  createdBy             String?
  updatedBy             String?

  @@unique([sharing, roomType, academicYearId])
  @@index([academicYearId])
}

// Per-student frozen pricing snapshot — captures what THIS student owes,
// independent of future config changes. Created when admin assigns hostel.
model StudentAccommodationPricing {
  id                    String        @id @default(dbgenerated("gen_random_uuid()"))
  studentId             String
  academicYearId        String?

  sharing               Int
  roomType              String
  paymentMode           String        // 'YEARWISE' | 'SEMWISE'
  hostelId              String?

  accommodationPrice    Float
  messPrice             Float
  laundryPrice          Float?        @default(0)
  registrationFee       Float

  adjustmentAmount      Float?        @default(0)
  adjustmentReason      String?
  effectiveTotal        Float

  pricingSource         String?       // 'CONFIG' | 'CUSTOM' | 'AUTO_BACKFILL'
  // Supersede semantics: at most one row per studentId may have isActive=true
  // (enforced by a partial unique index in migration SQL). Old rows are kept
  // with isActive=false + supersededAt for audit/refund history.
  isActive              Boolean       @default(true)
  supersededAt          DateTime?
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime?     @default(now())
  updatedAt             DateTime      @updatedAt

  student               Student       @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([studentId])
  @@index([studentId, isActive])
  @@index([hostelId])
}

model HostelBed {
  id         String            @id @default(dbgenerated("gen_random_uuid()"))
  roomId     String
  number     String
  isOccupied Boolean?          @default(false)
  createdAt  DateTime?         @default(now())
  updatedAt  DateTime          @updatedAt
  createdBy  String?
  updatedBy  String?
  allocation HostelAllocation?
  room       HostelRoom        @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model HostelAllocation {
  id        String                  @id @default(dbgenerated("gen_random_uuid()"))
  studentId String                  @unique
  bedId     String                  @unique
  startDate DateTime
  endDate   DateTime?
  status    HostelAllocationStatus? @default(ACTIVE)
  // Optional year tag. NULL = legacy / untagged. NOTE: studentId is still @unique —
  // one allocation per student. For true per-year hostel history, drop @unique and
  // add @@unique([studentId, academicYearId]) (turns the relation one-to-many).
  academicYearId String?
  createdAt DateTime?               @default(now())
  updatedAt DateTime                @updatedAt
  createdBy String?
  updatedBy String?
  bed       HostelBed               @relation(fields: [bedId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student   Student                 @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear AcademicYear?        @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([academicYearId])
}

model Vehicle {
  id          String           @id @default(dbgenerated("gen_random_uuid()"))
  number      String           @unique
  capacity    Int
  driverName  String
  driverPhone String
  photoUrl    String?
  isDeleted   Boolean?         @default(false)
  createdAt   DateTime?        @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   String?
  updatedBy   String?
  routes      TransportRoute[]
}

model TransportRoute {
  id                String                @id @default(dbgenerated("gen_random_uuid()"))
  name              String
  // `cost` is the *default* price used when no year-specific override exists in
  // TransportRouteYearlyPrice. Existing single-cost workflows keep working;
  // year-specific pricing is layered on top via the related model below.
  cost              Float
  city              String?
  busNumber         String?
  capacity          Int?                  @default(0)
  filled            Int?                  @default(0)
  vehicleId         String?
  pickupTime        String?               // HH:MM (24-hour). Time-only — no date.
  dropTime          String?               // HH:MM (24-hour). Time-only — no date.
  isDeleted         Boolean?              @default(false)
  createdAt         DateTime?             @default(now())
  updatedAt         DateTime              @updatedAt
  createdBy         String?
  updatedBy         String?
  studentAdmissions StudentAdmission[]
  allocations       TransportAllocation[]
  vehicle           Vehicle?              @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stops             TransportStop[]
  yearlyPrices      TransportRouteYearlyPrice[]
}

// Per-year cost override for a TransportRoute. Reader resolves cost as:
//   yearlyPrice(routeId, currentYearId)?.cost ?? route.cost
// So back-dated / lateral students into a past year get the price that was
// effective in that year, while current students continue to use route.cost.
model TransportRouteYearlyPrice {
  id              String         @id @default(dbgenerated("gen_random_uuid()"))
  routeId         String
  academicYearId  String
  cost            Float
  createdAt       DateTime?      @default(now())
  updatedAt       DateTime       @updatedAt
  createdBy       String?
  updatedBy       String?

  route           TransportRoute @relation(fields: [routeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear    AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([routeId, academicYearId])
  @@index([academicYearId])
}

model TransportStop {
  id          String                @id @default(dbgenerated("gen_random_uuid()"))
  routeId     String
  name        String
  sequence    Int
  isDeleted   Boolean?              @default(false)
  createdAt   DateTime?             @default(now())
  updatedAt   DateTime              @updatedAt
  createdBy   String?
  updatedBy   String?
  allocations TransportAllocation[]
  route       TransportRoute        @relation(fields: [routeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model TransportAllocation {
  id        String                     @id @default(dbgenerated("gen_random_uuid()"))
  studentId String                     @unique
  routeId   String
  stopId    String
  startDate DateTime
  endDate   DateTime?
  status    TransportAllocationStatus? @default(ACTIVE)
  // Optional year tag. NULL = legacy / untagged. NOTE: studentId is still @unique —
  // one allocation per student. For true per-year transport history, drop @unique
  // and add @@unique([studentId, academicYearId]) (turns the relation one-to-many).
  academicYearId String?
  createdAt DateTime?                  @default(now())
  updatedAt DateTime                   @updatedAt
  createdBy String?
  updatedBy String?
  route     TransportRoute             @relation(fields: [routeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stop      TransportStop              @relation(fields: [stopId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student   Student                    @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear AcademicYear?           @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([academicYearId])
}

model FeeHead {
  id                String             @id @default(dbgenerated("gen_random_uuid()"))
  name              String
  description       String?
  // Explicit link to the PaymentComponent enum — kills name-keyword matching across the codebase.
  // Optional for backward compat with legacy heads (fall back to name keywords until backfill).
  component         PaymentComponent?
  isDeleted         Boolean?           @default(false)
  createdAt         DateTime?          @default(now())
  updatedAt         DateTime           @updatedAt
  createdBy         String?
  updatedBy         String?
  structures        FeeStructure[]
  payments          Payment[]
  studentFeeDemands StudentFeeDemand[]
}

