  documentUrl String?
  status      DiscountStatus @default(REQUESTED)
  remarks     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([studentId, status])
}


// ... (Existing Enums)



// RBAC Models
model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "STUDENT_VIEW", "FEES_EDIT"
  description String?
  module      String   // e.g. "FINANCE", "ACADEMIC"
  
  rolePermissions RolePermission[]
  customRolePermissions CustomRolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role       // Links Enum Role to Permissions (Static Roles)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, permissionId])
}

model CustomRole {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. "Guest Lecturer", "Exam Cell Clerk"
  description String?
  
  users       User[]
  permissions CustomRolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?
}

model CustomRolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         CustomRole @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}



// Financial Ledger System
enum LedgerTransactionType {
  CREDIT  // Payment, Scholarship, Waiver
  DEBIT   // Fee Demand, Penalty
}

model StudentLedger {
  id          String                @id @default(uuid())
  studentId   String
  student     Student               @relation(fields: [studentId], references: [id])
  
  type        LedgerTransactionType
  amount      Float
  description String
  date        DateTime              @default(now())
  
  // Linking to source documents
  referenceId   String?  // ID of Payment or FeeDemand
  referenceType String?  // "PAYMENT", "FEE_DEMAND", "DISCOUNT"
  
  // Balance Snapshot (Optional but useful for quick checks)
  runningBalance Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  // Audit: Who created this entry
}

// System Core
model SystemSetting {
  key         String   @id // e.g., "ADMISSION_OPEN"
  value       String   // JSON value: "true", "2025-05-20"
  description String?
  isLocked    Boolean  @default(false) // If true, even admins can't easy-edit without super-admin
  
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  
  action    String   // "UPDATE", "DELETE", "LOGIN"
  entity    String   // "Student", "FeeStructure"
  entityId  String?
  details   Json?    // Before/After state
  
  ipAddress String?
  userAgent String?
  
  createdAt DateTime @default(now())
}



model CancellationRequest {
  id           String             @id @default(uuid())
  studentId    String
  student      Student            @relation(fields: [studentId], references: [id])
  reason       String
  refundAmount Float?
  status       CancellationStatus @default(REQUESTED)
  approvedBy   String? 
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  createdBy    String?
  updatedBy    String?

  @@index([studentId, status])
}

model FileUpload {
  id         String   @id @default(uuid())
  studentId  String?
  student    Student? @relation(fields: [studentId], references: [id])
  uploadedBy String? 
  url        String
  kind       FileKind
  fileName   String?
  mime       String?
  size       Int?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String?
  updatedBy  String?

  @@index([studentId])
}

model ExamDate {
  id                String             @id @default(uuid())
  name              String?
  date              DateTime
  startTime         DateTime?
  endTime           DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  attendanceRecords AttendanceRecord[]
  createdBy         String?
  updatedBy         String?

  @@index([date])
}

model ExamCenter {
  id        String     @id @default(uuid())
  name      String
  address   String?
  city      String?
  capacity  Int?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  examSlots ExamSlot[]
  createdBy String?
  updatedBy String?
  isDeleted Boolean @default(false)

  @@index([city])
  @@index([isDeleted])
}

model ExamSlot {
  id               String        @id @default(uuid())
  examCenterId     String
  examCenter       ExamCenter    @relation(fields: [examCenterId], references: [id])
  date             DateTime
  startTime        DateTime
  endTime          DateTime
  capacity         Int
  filled           Int           @default(0)
  isBookingEnabled Boolean       @default(false)  // Admin controls this
  studentExams     StudentExam[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  createdBy        String?
  updatedBy        String?
  isDeleted        Boolean  @default(false)

  @@index([examCenterId])
  @@index([date])
  @@index([isBookingEnabled])
  @@index([isDeleted])
  @@index([date, examCenterId])
}

model HallTicket {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  fileId      String? 
  url         String?
  qrHash      String?
  generatedAt DateTime @default(now())
  createdBy   String?
  updatedBy   String?

  @@index([studentId])
}

model InvigilatorCredential {
  id         String   @id @default(uuid())
  adminId    String 
  token      String
  validFrom  DateTime
  validUntil DateTime
  createdAt  DateTime @default(now())
  createdBy  String?
  updatedBy  String?

  @@index([adminId])
  @@index([token])
  @@index([validFrom, validUntil])
}

model AttendanceRecord {
  id            String    @id @default(uuid())
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id])
  examDateId    String?
  examDate      ExamDate? @relation(fields: [examDateId], references: [id])
  invigilatorId String?
  scannedAt     DateTime  @default(now())
  verified      Boolean   @default(false)
  verifiedAt    DateTime?
  createdBy     String?
  updatedBy     String?

  @@index([studentId])
  @@index([examDateId])
  @@index([invigilatorId])
  @@index([scannedAt])
  @@index([verified])
}

model SeatAllocation {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  oldCourse   String?
  newCourse   String?
  allocatedBy String? 
  allocatedAt DateTime @default(now())
  notes       String?
  createdBy   String?
  updatedBy   String?

  @@index([studentId])
}

model CourseChangeRequest {
  id          String        @id @default(uuid())
  studentId   String
  student     Student       @relation(fields: [studentId], references: [id])
  fromCourse  String
  toCourse    String
  reason      String
  status      RequestStatus @default(REQUESTED)
  forwardedTo String?
  actionedBy  String?
  actionedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   String?
  updatedBy   String?

  @@index([studentId, status])
}

model AgentCommission {
  id        String                @id @default(uuid())
  agentId   String
  agent     User                  @relation(fields: [agentId], references: [id])
  studentId String
  student   Student               @relation(fields: [studentId], references: [id])
  amount    Float
  component String
  status    AgentCommissionStatus @default(PENDING)
  createdAt DateTime              @default(now())
  createdBy String?
  updatedBy String?

  @@index([agentId])
  @@index([studentId, status])
}

model AdminActivityLog {
  id           String   @id @default(uuid())
  adminId      String
  admin        User     @relation(fields: [adminId], references: [id])
  action       String
  resourceType String?
  resourceId   String?
  details      Json?
  createdAt    DateTime @default(now())
  createdBy    String?
  updatedBy    String?

  @@index([adminId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String
  recipient   User     @relation(fields: [recipientId], references: [id])
  type        String
  title       String
  body        String
  link        String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  createdBy   String?
  updatedBy   String?

  @@index([recipientId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
  @@index([recipientId, isRead])
}

model OfflineUploadBatch {
  id            String                   @id @default(uuid())
  agentId       String?
  uploadedBy    String?
  sourceFileUrl String?
  status        OfflineUploadBatchStatus @default(PENDING)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  createdBy     String?
  updatedBy     String?

  @@index([agentId])
  @@index([status])
  @@index([createdAt])
}

model DocumentRequirement {
  id           String   @id @default(uuid())
  courseType   String 
  documentName String 
  documentKey  String 
  isRequired   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  updatedBy    String?
  isDeleted    Boolean  @default(false)

  @@unique([courseType, documentKey])
  @@index([courseType])
  @@index([isDeleted])
}

model Configuration {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?
}

model ScholarshipRule {
  id                 String   @id @default(uuid())
  name               String
  minPercentile      Float
  discountPercentage Float
  totalSlots         Int
  filledSlots        Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  eligibleStudents Student[]
  allocations        ScholarshipAllocation[]
}

model ScholarshipAllocation {
  id            String            @id @default(uuid())
  studentId     String            @unique 
  student       Student           @relation(fields: [studentId], references: [id])

  ruleId        String
  rule          ScholarshipRule   @relation(fields: [ruleId], references: [id])
  
  status        ScholarshipStatus @default(RESERVED)
  reservedAt    DateTime          @default(now())
  lockedAt      DateTime?
  expiresAt     DateTime?
  
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@index([expiresAt])
}


