enum PaymentMode {
  ONLINE
  OFFLINE
}

enum PaymentMethod {
  // Online Methods
  UPI
  CREDIT_CARD
  DEBIT_CARD
  NET_BANKING
  WALLET
  
  // Offline Methods
  CASH
  CHEQUE
  DEMAND_DRAFT
  NEFT_RTGS // Direct bank transfer by student (verified by admin)
}

model Payment {
  id         String           @id @default(uuid())
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id])
  
  // Amount Details
  amount     Float
  currency   String           @default("INR")
  
  // Tracking
  status     PaymentStatus    @default(PENDING)
  mode       PaymentMode      @default(ONLINE) 
  method     PaymentMethod?
  
  // Online Specifics
  providerTxId   String?  // e.g. Razorpay Payment ID
  merchantOrderId String? // Our internal Order ID sent to gateway
  signature      String?  // Verification signature
  
  // Offline Specifics
  referenceNumber String? // DD Number, Cheque Number, or UTR
  bankName        String? // Bank issuing the DD/Cheque
  branchName      String?
  instrumentDate  DateTime? // Date on DD/Cheque
  collectedBy     String?   // User ID of the admin/staff who collected cash
  
  // Categorization
  component  PaymentComponent
  metadata   Json? // Extra gateway details or remarks
  invoiceUrl String?

  
  feeDemandId String?
  feeDemand   StudentFeeDemand? @relation(fields: [feeDemandId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([studentId, status])
  @@index([providerTxId])
  @@index([referenceNumber])
  @@index([mode])
}




model AcademicQualification {
  id               String  @id @default(uuid())
  studentId        String
  student          Student @relation(fields: [studentId], references: [id])
  level            String 
  board            String
  yearOfPassing    String
  hallTicketNumber String
  gpaOrMarks       String 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([studentId])
}

model CourseChangeLog {
