model Student {
  id            String @id @default(uuid())
  applicationId String @unique 

  
  name            String
  fatherName      String
  motherName      String
  gender          String
  dob             DateTime
  phone           String
  email           String   @unique
  aadharNumber    String
  category        String
  country         String
  address         String
  address2        String?
  city            String
  state           String
  pincode         String
  profilePhotoUrl String? 
  documentFolderPath String? // S3 Key prefix for student docs

  source    AdmissionSource @default(WEBSITE)
  ledgerEntries StudentLedger[]

  // Use new enums for better flow control
  quotaType       QuotaType       @default(MANAGEMENT)
  applicationMode ApplicationMode @default(ONLINE)
  
  // Keep isOffline for backward compatibility if needed, but mark deprecated or sync with applicationMode
  isOffline Boolean @default(false) 
  isKycVerified Boolean @default(false)

  
  courseType String? 

  
  pref1 String?
  pref2 String?
  pref3 String?

  userId String? @unique
  user   User?   @relation("StudentUser", fields: [userId], references: [id])
  
  agentId String?
  agent   User?   @relation("AgentStudents", fields: [agentId], references: [id])

  examDetails      StudentExam?
  admissionDetails StudentAdmission?
  convenorDetails  ConvenorAdmission?
  documents        StudentDocument[]

  academicQualifications AcademicQualification[]
  courseChangeLogs       CourseChangeLog[]
  discountRequests       DiscountRequest[]
  cancellationRequests   CancellationRequest[]
  courseChangeRequests   CourseChangeRequest[]
  agentCommissions       AgentCommission[]
  seatAllocations        SeatAllocation[]
  hallTickets            HallTicket[]
  attendanceRecords      AttendanceRecord[]
  payments               Payment[]
  fileUploads            FileUpload[]

  
  enrollment          StudentEnrollment?
  hostelAllocation    HostelAllocation?
  transportAllocation TransportAllocation?
  feeDemands          StudentFeeDemand[]
  scholarshipAllocation ScholarshipAllocation?

  eligibleScholarshipRuleId String? // Admin manually selects this rule
  eligibleScholarshipRule   ScholarshipRule? @relation(fields: [eligibleScholarshipRuleId], references: [id])


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([userId])
  @@index([agentId])
  @@index([phone])
  @@index([aadharNumber])
  @@index([courseType])
  @@index([quotaType])
  @@index([applicationMode])
  @@index([isKycVerified])
  @@index([createdAt])
  @@index([category])
  @@index([city, state])
}

model ConvenorAdmission {
  id        String   @id @default(uuid())
  studentId String   @unique
  student   Student  @relation(fields: [studentId], references: [id])
  
  // Specific fields for Convenor/EMCET data
  rank           String?
  hallTicketNo   String? 
  allotmentOrder String? // File URL or Number
  councilId      String? // Unique ID in council DB
  category       String? // Council specific category if different
  joiningReport  String? // File URL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?
}

model DataImportMapping {
  id        String     @id @default(uuid())
  name      String     @unique // e.g., "OMR_MAPPING_V1", "EMCET_2025"
  type      ImportType
  
  // JSON Key-Value pair: "ExcelHeader": "DBField"
  // e.g., { "Candidate Name": "name", "Mobile No": "phone" }
  mapping   Json       
  
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  createdBy String?
  updatedBy String?
}




model StudentExam {
  id        String  @id @default(uuid())
  studentId String  @unique
  student   Student @relation(fields: [studentId], references: [id])

  hallTicketUrl String?
  testDate      DateTime?
  testCenter    String?
  examAttended  Boolean   @default(false)
  examScore     Float? // Internal raw score or legacy
  
  // External / Standardized Scores
  class12Aggregate Float?
  jeePercentile    Float? 
  satScore         Float?
  vvitPercentile   Float?

  isQualified   Boolean?  @default(false)
  createdBy     String?
  updatedBy     String? // ID of Verification Officer

  examSlotId String?
  examSlot   ExamSlot? @relation(fields: [examSlotId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([examSlotId])
  @@index([examAttended])
  @@index([isQualified])
  @@index([testDate])
}

model StudentAdmission {
  id        String  @id @default(uuid())
  studentId String  @unique
  student   Student @relation(fields: [studentId], references: [id])

  status AdmissionStatus @default(REGISTERED)
  qualificationMode QualificationMode? // How student qualified (EXAM or DIRECT)

  
  allottedSpecialization String?

  
  totalFee  Float     @default(0)
  paidFee   Float     @default(0)
  feeStatus FeeStatus @default(PENDING)

  
  accommodationType AccommodationType @default(NONE)
  hostelType        HostelType?
  hostelId          String?
  hostel            Hostel?           @relation(fields: [hostelId], references: [id])
  roomNumber        String?
  transportRouteId  String?
  transportRoute    TransportRoute?   @relation(fields: [transportRouteId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([feeStatus])
  @@index([accommodationType])
  @@index([hostelId])
  @@index([transportRouteId])
  @@index([allottedSpecialization])
}

model StudentDocument {
  id        String  @id @default(uuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  documentKey String 
  url         String
  status      StudentDocumentStatus @default(PENDING)
  remarks     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@unique([studentId, documentKey])
  @@index([studentId])
  isDeleted Boolean @default(false)
}

model Specialization {
  id          String   @id @default(uuid())
  code        String   @unique 
  name        String
  courseId   String
  course     Course  @relation(fields: [courseId], references: [id])
  totalSeats  Int
  filledSeats Int      @default(0)
  batches     Batch[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?
  isDeleted   Boolean  @default(false)

  @@index([courseId])
  @@index([isDeleted])
}



model Hostel {
  id       String     @id @default(uuid())
  name     String
  type     String // 'Boys' or 'Girls'
  wardenName String?
  capacity Int
  filled   Int        @default(0)

  // cost removed from Hostel, moved to HostelRoom


  
  blockName  String?
  roomNumber String?

  studentAdmissions StudentAdmission[] 
  blocks            HostelBlock[] 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean @default(false)

  @@index([type])
  @@index([isDeleted])
}

model HostelBlock {
