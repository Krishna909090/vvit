generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  name              String?
  email             String?            @unique
  phone             String             @unique
  role              Role               @default(STUDENT)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdBy         String?
  updatedBy         String?
  customRoleId      String?
  isDeleted         Boolean            @default(false)
  password          String?
  adminActivityLogs AdminActivityLog[]
  agentCommissions  AgentCommission[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  agentStudents     Student[]          @relation("AgentStudents")
  studentProfile    Student?           @relation("StudentUser")
  customRole        CustomRole?        @relation(fields: [customRoleId], references: [id])
  otps              UserOtp[]

  @@index([role])
  @@index([createdAt])
  @@index([isDeleted])
}

model UserOtp {
  id          String   @id @default(uuid())
  userId      String
  type        String
  otpHash     String
  expiresAt   DateTime
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, type, used, expiresAt])
}

model School {
  id          String       @id @default(uuid())
  name        String       @unique
  code        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   String?
  updatedBy   String?
  isDeleted   Boolean      @default(false)
  departments Department[]

  @@index([isDeleted])
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean  @default(false)
  schoolId  String?
  courses   Course[]
  school    School?  @relation(fields: [schoolId], references: [id])

  @@index([isDeleted])
}

model Course {
  id               String             @id @default(uuid())
  code             String             @unique
  name             String
  departmentId     String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  createdBy        String?
  updatedBy        String?
  isDeleted        Boolean            @default(false)
  degree           String?
  filledSeats      Int                @default(0)
  totalSeats       Int                @default(0)
  department       Department         @relation(fields: [departmentId], references: [id])
  feeStructures    FeeStructure[]
  specializations  Specialization[]
  studentsPref1    Student[]          @relation("Pref1")
  studentsPref2    Student[]          @relation("Pref2")
  studentsPref3    Student[]          @relation("Pref3")
  allottedStudents StudentAdmission[] @relation("AllottedCourse")

  @@unique([name, departmentId])
  @@index([departmentId])
  @@index([isDeleted])
}

model Batch {
  id               String         @id @default(uuid())
  name             String
  startDate        DateTime
  endDate          DateTime
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  createdBy        String?
  updatedBy        String?
  isDeleted        Boolean        @default(false)
  specializationId String
  specialization   Specialization @relation(fields: [specializationId], references: [id])
  sections         Section[]

  @@index([specializationId])
  @@index([isDeleted])
  @@index([startDate, endDate])
}

model Section {
  id        String              @id @default(uuid())
  name      String
  batchId   String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean             @default(false)
  batch     Batch               @relation(fields: [batchId], references: [id])
  students  StudentEnrollment[]

  @@index([batchId])
  @@index([isDeleted])
}

model AcademicYear {
  id            String              @id @default(uuid())
  code          String              @unique
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean             @default(true)
  isLocked      Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  createdBy     String?
  updatedBy     String?
  isDeleted     Boolean             @default(false)
  feeStructures FeeStructure[]
  enrollments   StudentEnrollment[]

  @@index([isActive])
  @@index([isDeleted])
}

model StudentEnrollment {
  id              String           @id @default(uuid())
  studentId       String           @unique
  sectionId       String
  rollNumber      String           @unique
  currentSemester Int              @default(1)
  academicYearId  String
  status          EnrollmentStatus @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       String?
  updatedBy       String?
  academicYear    AcademicYear     @relation(fields: [academicYearId], references: [id])
  section         Section          @relation(fields: [sectionId], references: [id])
  student         Student          @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([rollNumber])
  @@index([sectionId])
  @@index([academicYearId])
  @@index([status])
  @@index([currentSemester])
}

model Student {
  id                        String                  @id @default(uuid())
  applicationId             String                  @unique
  name                      String
  fatherName                String
  motherName                String
  gender                    String
  dob                       DateTime
  phone                     String
  email                     String                  @unique
  aadharNumber              String
  category                  String
  country                   String
  address                   String
  address2                  String?
  city                      String
  state                     String
  pincode                   String
  profilePhotoUrl           String?
  documentFolderPath        String?
  source                    AdmissionSource         @default(WEBSITE)
  quotaType                 QuotaType               @default(MANAGEMENT)
  applicationMode           ApplicationMode         @default(ONLINE)
  isOffline                 Boolean                 @default(false)
  isKycVerified             Boolean                 @default(false)
  pref1                     String?
  pref2                     String?
  pref3                     String?
  userId                    String?                 @unique
  agentId                   String?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  createdBy                 String?
  updatedBy                 String?
  eligibleScholarshipRuleId String?
  degreeType                String?
  courseType                String?
  scholarshipRemarks        String?
  scholarshipVerified       Boolean                 @default(false)
  scholarshipVerifiedAt     DateTime?
  scholarshipVerifiedBy     String?
  academicQualifications    AcademicQualification[]
  agentCommissions          AgentCommission[]
  attendanceRecords         AttendanceRecord[]
  cancellationRequests      CancellationRequest[]
  convenorDetails           ConvenorAdmission?
  courseChangeLogs          CourseChangeLog[]
  courseChangeRequests      CourseChangeRequest[]
  discountRequests          DiscountRequest[]
  fileUploads               FileUpload[]
  hallTickets               HallTicket[]
  hostelAllocation          HostelAllocation?
  payments                  Payment[]
  scholarshipAllocation     ScholarshipAllocation?
  seatAllocations           SeatAllocation[]
  agent                     User?                   @relation("AgentStudents", fields: [agentId], references: [id])
  eligibleScholarshipRule   ScholarshipRule?        @relation(fields: [eligibleScholarshipRuleId], references: [id])
  pref1Course               Course?                 @relation("Pref1", fields: [pref1], references: [id])
  pref2Course               Course?                 @relation("Pref2", fields: [pref2], references: [id])
  pref3Course               Course?                 @relation("Pref3", fields: [pref3], references: [id])
  user                      User?                   @relation("StudentUser", fields: [userId], references: [id])
  admissionDetails          StudentAdmission?
  documents                 StudentDocument[]
  enrollment                StudentEnrollment?
  examDetails               StudentExam?
  feeDemands                StudentFeeDemand[]
  ledgerEntries             StudentLedger[]
  transportAllocation       TransportAllocation?

  @@index([userId])
  @@index([agentId])
  @@index([phone])
  @@index([aadharNumber])
  @@index([degreeType])
  @@index([quotaType])
  @@index([applicationMode])
  @@index([isKycVerified])
  @@index([createdAt])
  @@index([category])
  @@index([city, state])
}

model ConvenorAdmission {
  id             String   @id @default(uuid())
  studentId      String   @unique
  rank           String?
  hallTicketNo   String?
  allotmentOrder String?
  councilId      String?
  category       String?
  joiningReport  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?
  updatedBy      String?
  student        Student  @relation(fields: [studentId], references: [id])
}

model DataImportMapping {
  id        String     @id @default(uuid())
  name      String     @unique
  type      ImportType
  mapping   Json
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  createdBy String?
  updatedBy String?
}

model StudentExam {
  id               String    @id @default(uuid())
  studentId        String    @unique
  hallTicketUrl    String?
  testDate         DateTime?
  testCenter       String?
  examAttended     Boolean   @default(false)
  examScore        Float?
  isQualified      Boolean?  @default(false)
  examSlotId       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  class12Aggregate Float?
  jeePercentile    Float?
  satScore         Float?
  vvitPercentile   Float?
  createdBy        String?
  updatedBy        String?
  examSlot         ExamSlot? @relation(fields: [examSlotId], references: [id])
  student          Student   @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([examSlotId])
  @@index([examAttended])
  @@index([isQualified])
  @@index([testDate])
}

model StudentAdmission {
  id                String             @id @default(uuid())
  studentId         String             @unique
  status            AdmissionStatus    @default(REGISTERED)
  qualificationMode QualificationMode?
  totalFee          Float              @default(0)
  paidFee           Float              @default(0)
  feeStatus         FeeStatus          @default(PENDING)
  accommodationType AccommodationType  @default(NONE)
  hostelType        HostelType?
  hostelId          String?
  transportRouteId  String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  roomNumber        String?
  allottedCourseId  String?
  allottedCourse    Course?            @relation("AllottedCourse", fields: [allottedCourseId], references: [id])
  hostel            Hostel?            @relation(fields: [hostelId], references: [id])
  student           Student            @relation(fields: [studentId], references: [id])
  transportRoute    TransportRoute?    @relation(fields: [transportRouteId], references: [id])

  @@index([studentId])
  @@index([status])
  @@index([feeStatus])
  @@index([accommodationType])
  @@index([hostelId])
  @@index([transportRouteId])
  @@index([allottedCourseId])
}

model StudentDocument {
  id          String                @id @default(uuid())
  studentId   String
  documentKey String
  url         String
  status      StudentDocumentStatus @default(PENDING)
  remarks     String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  createdBy   String?
  updatedBy   String?
  isDeleted   Boolean               @default(false)
  student     Student               @relation(fields: [studentId], references: [id])

  @@unique([studentId, documentKey])
  @@index([studentId])
}

model Specialization {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  courseId    String
  totalSeats  Int
  filledSeats Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?
  isDeleted   Boolean  @default(false)
  batches     Batch[]
  course      Course   @relation(fields: [courseId], references: [id])

  @@index([courseId])
  @@index([isDeleted])
}

model Hostel {
  id                String             @id @default(uuid())
  name              String
  type              String
  wardenName        String?
  capacity          Int
  filled            Int                @default(0)
  blockName         String?
  roomNumber        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdBy         String?
  updatedBy         String?
  isDeleted         Boolean            @default(false)
  blocks            HostelBlock[]
  studentAdmissions StudentAdmission[]

  @@index([type])
  @@index([isDeleted])
}

model HostelBlock {
  id        String       @id @default(uuid())
  hostelId  String
  name      String
  type      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean      @default(false)
  hostel    Hostel       @relation(fields: [hostelId], references: [id])
  rooms     HostelRoom[]

  @@index([hostelId])
  @@index([isDeleted])
}

model HostelRoom {
  id        String      @id @default(uuid())
  blockId   String
  number    String
  capacity  Int
  type      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean     @default(false)
  cost      Float       @default(0)
  beds      HostelBed[]
  block     HostelBlock @relation(fields: [blockId], references: [id])

  @@index([blockId])
  @@index([isDeleted])
}

model HostelPriceCategory {
  id        String         @id @default(uuid())
  sharing   Int
  roomType  HostelRoomType
  price     Float
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  createdBy String?
  updatedBy String?

  @@unique([sharing, roomType])
}

model HostelBed {
  id         String            @id @default(uuid())
  roomId     String
  number     String
  isOccupied Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  createdBy  String?
  updatedBy  String?
  allocation HostelAllocation?
  room       HostelRoom        @relation(fields: [roomId], references: [id])

  @@index([roomId])
  @@index([isOccupied])
}

model HostelAllocation {
  id        String                 @id @default(uuid())
  studentId String                 @unique
  bedId     String                 @unique
  startDate DateTime
  endDate   DateTime?
  status    HostelAllocationStatus @default(ACTIVE)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  createdBy String?
  updatedBy String?
  bed       HostelBed              @relation(fields: [bedId], references: [id])
  student   Student                @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([bedId])
  @@index([status])
  @@index([startDate, endDate])
}

model Vehicle {
  id          String           @id @default(uuid())
  number      String           @unique
  capacity    Int
  driverName  String
  driverPhone String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   String?
  updatedBy   String?
  isDeleted   Boolean          @default(false)
  routes      TransportRoute[]

  @@index([isDeleted])
}

model TransportRoute {
  id                String                @id @default(uuid())
  name              String
  cost              Float
  city              String
  busNumber         String?
  capacity          Int                   @default(0)
  filled            Int                   @default(0)
  vehicleId         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  createdBy         String?
  updatedBy         String?
  isDeleted         Boolean               @default(false)
  studentAdmissions StudentAdmission[]
  allocations       TransportAllocation[]
  vehicle           Vehicle?              @relation(fields: [vehicleId], references: [id])
  stops             TransportStop[]

  @@index([vehicleId])
  @@index([city])
  @@index([isDeleted])
}

model TransportStop {
  id          String                @id @default(uuid())
  routeId     String
  name        String
  sequence    Int
  pickupTime  DateTime
  dropTime    DateTime
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  createdBy   String?
  updatedBy   String?
  isDeleted   Boolean               @default(false)
  allocations TransportAllocation[]
  route       TransportRoute        @relation(fields: [routeId], references: [id])

  @@index([routeId])
  @@index([isDeleted])
  @@index([sequence])
}

model TransportAllocation {
  id        String                    @id @default(uuid())
  studentId String                    @unique
  routeId   String
  stopId    String
  startDate DateTime
  endDate   DateTime?
  status    TransportAllocationStatus @default(ACTIVE)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  createdBy String?
  updatedBy String?
  route     TransportRoute            @relation(fields: [routeId], references: [id])
  stop      TransportStop             @relation(fields: [stopId], references: [id])
  student   Student                   @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([routeId])
  @@index([stopId])
  @@index([status])
  @@index([startDate, endDate])
}

model FeeHead {
  id          String         @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   String?
  updatedBy   String?
  isDeleted   Boolean        @default(false)
  structures  FeeStructure[]

  @@index([isDeleted])
}

model FeeStructure {
  id             String             @id @default(uuid())
  courseId       String
  feeHeadId      String
  amount         Float
  currency       String             @default("INR")
  academicYearId String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  createdBy      String?
  updatedBy      String?
  isDeleted      Boolean            @default(false)
  quotaType      QuotaType?
  courseType     String?
  dueDate        DateTime?
  yearOfStudy    Int?
  degreeId       String?
  academicYear   AcademicYear       @relation(fields: [academicYearId], references: [id])
  course         Course             @relation(fields: [courseId], references: [id])
  feeHead        FeeHead            @relation(fields: [feeHeadId], references: [id])
  demands        StudentFeeDemand[]

  @@index([courseId, academicYearId])
  @@index([quotaType])
  @@index([yearOfStudy])
}

model StudentFeeDemand {
  id             String       @id @default(uuid())
  studentId      String
  feeStructureId String
  amount         Float
  dueDate        DateTime
  status         FeeStatus
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String?
  updatedBy      String?
  payments       Payment[]
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id])
  student        Student      @relation(fields: [studentId], references: [id])

  @@index([studentId, status])
}

model Payment {
  id              String            @id @default(uuid())
  studentId       String
  amount          Float
  currency        String            @default("INR")
  status          PaymentStatus     @default(PENDING)
  mode            PaymentMode       @default(ONLINE)
  method          PaymentMethod?
  providerTxId    String?
  merchantOrderId String?
  signature       String?
  referenceNumber String?
  bankName        String?
  branchName      String?
  instrumentDate  DateTime?
  collectedBy     String?
  component       PaymentComponent
  metadata        Json?
  invoiceUrl      String?
  feeDemandId     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  createdBy       String?
  updatedBy       String?
  feeDemand       StudentFeeDemand? @relation(fields: [feeDemandId], references: [id])
  student         Student           @relation(fields: [studentId], references: [id])

  @@index([studentId, status])
  @@index([providerTxId])
  @@index([referenceNumber])
  @@index([mode])
  @@index([createdAt])
}

model AcademicQualification {
  id               String   @id @default(uuid())
  studentId        String
  level            String
  board            String
  yearOfPassing    String
  hallTicketNumber String
  gpaOrMarks       String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String?
  updatedBy        String?
  student          Student  @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

model CourseChangeLog {
  id         String   @id @default(uuid())
  studentId  String
  oldCourse  String
  newCourse  String
  approvedBy String
  date       DateTime @default(now())
  createdBy  String?
  updatedBy  String?
  student    Student  @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

model DiscountRequest {
  id              String         @id @default(uuid())
  studentId       String
  reason          String
  documentUrl     String?
  status          DiscountStatus @default(REQUESTED)
  remarks         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdBy       String?
  updatedBy       String?
  approvedAmount  Float?
  approvedAt      DateTime?
  approvedBy      String?
  component       String?
  requestedAmount Float          @default(0)
  student         Student        @relation(fields: [studentId], references: [id])

  @@index([studentId, status])
}

model Permission {
  id                    String                 @id @default(uuid())
  code                  String                 @unique
  description           String?
  module                String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  customRolePermissions CustomRolePermission[]
  rolePermissions       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([role, permissionId])
}

model CustomRole {
  id          String                 @id @default(uuid())
  name        String                 @unique
  description String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  createdBy   String?
  updatedBy   String?
  permissions CustomRolePermission[]
  users       User[]
}

model CustomRolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         CustomRole @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}

model StudentLedger {
  id             String                @id @default(uuid())
  studentId      String
  type           LedgerTransactionType
  amount         Float
  description    String
  date           DateTime              @default(now())
  referenceId    String?
  referenceType  String?
  runningBalance Float?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  createdBy      String?
  student        Student               @relation(fields: [studentId], references: [id])
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  isLocked    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model CancellationRequest {
  id           String             @id @default(uuid())
  studentId    String
  reason       String
  refundAmount Float?
  status       CancellationStatus @default(REQUESTED)
  approvedBy   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  createdBy    String?
  updatedBy    String?
  student      Student            @relation(fields: [studentId], references: [id])

  @@index([studentId, status])
}

model FileUpload {
  id         String   @id @default(uuid())
  studentId  String?
  uploadedBy String?
  url        String
  kind       FileKind
  fileName   String?
  mime       String?
  size       Int?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String?
  updatedBy  String?
  student    Student? @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

model ExamDate {
  id                String             @id @default(uuid())
  name              String?
  date              DateTime
  startTime         DateTime?
  endTime           DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdBy         String?
  updatedBy         String?
  attendanceRecords AttendanceRecord[]

  @@index([date])
}

model ExamCenter {
  id        String     @id @default(uuid())
  name      String
  address   String?
  city      String?
  capacity  Int?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean    @default(false)
  examSlots ExamSlot[]

  @@index([city])
  @@index([isDeleted])
}

model ExamSlot {
  id               String        @id @default(uuid())
  examCenterId     String
  date             DateTime
  startTime        DateTime
  endTime          DateTime
  capacity         Int
  filled           Int           @default(0)
  isBookingEnabled Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  createdBy        String?
  updatedBy        String?
  isDeleted        Boolean       @default(false)
  examCenter       ExamCenter    @relation(fields: [examCenterId], references: [id])
  studentExams     StudentExam[]

  @@index([examCenterId])
  @@index([date])
  @@index([isBookingEnabled])
  @@index([isDeleted])
  @@index([date, examCenterId])
}

model HallTicket {
  id          String   @id @default(uuid())
  studentId   String
  fileId      String?
  url         String?
  qrHash      String?
  generatedAt DateTime @default(now())
  createdBy   String?
  updatedBy   String?
  student     Student  @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

model InvigilatorCredential {
  id         String   @id @default(uuid())
  adminId    String
  token      String
  validFrom  DateTime
  validUntil DateTime
  createdAt  DateTime @default(now())
  createdBy  String?
  updatedBy  String?

  @@index([adminId])
  @@index([token])
  @@index([validFrom, validUntil])
}

model AttendanceRecord {
  id            String    @id @default(uuid())
  studentId     String
  examDateId    String?
  invigilatorId String?
  scannedAt     DateTime  @default(now())
  verified      Boolean   @default(false)
  verifiedAt    DateTime?
  createdBy     String?
  updatedBy     String?
  examDate      ExamDate? @relation(fields: [examDateId], references: [id])
  student       Student   @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([examDateId])
  @@index([invigilatorId])
  @@index([scannedAt])
  @@index([verified])
}

model SeatAllocation {
  id          String   @id @default(uuid())
  studentId   String
  oldCourse   String?
  newCourse   String?
  allocatedBy String?
  allocatedAt DateTime @default(now())
  notes       String?
  createdBy   String?
  updatedBy   String?
  student     Student  @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

model CourseChangeRequest {
  id          String        @id @default(uuid())
  studentId   String
  fromCourse  String
  toCourse    String
  reason      String
  status      RequestStatus @default(REQUESTED)
  forwardedTo String?
  actionedBy  String?
  actionedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   String?
  updatedBy   String?
  student     Student       @relation(fields: [studentId], references: [id])

  @@index([studentId, status])
}

model AgentCommission {
  id        String                @id @default(uuid())
  agentId   String
  studentId String
  amount    Float
  component String
  status    AgentCommissionStatus @default(PENDING)
  createdAt DateTime              @default(now())
  createdBy String?
  updatedBy String?
  agent     User                  @relation(fields: [agentId], references: [id])
  student   Student               @relation(fields: [studentId], references: [id])

  @@index([agentId])
  @@index([studentId, status])
}

model AdminActivityLog {
  id           String   @id @default(uuid())
  adminId      String
  action       String
  resourceType String?
  resourceId   String?
  details      Json?
  createdAt    DateTime @default(now())
  createdBy    String?
  updatedBy    String?
  admin        User     @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String
  type        String
  title       String
  body        String
  link        String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  createdBy   String?
  updatedBy   String?
  recipient   User     @relation(fields: [recipientId], references: [id])

  @@index([recipientId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
  @@index([recipientId, isRead])
}

model OfflineUploadBatch {
  id            String                   @id @default(uuid())
  agentId       String?
  uploadedBy    String?
  sourceFileUrl String?
  status        OfflineUploadBatchStatus @default(PENDING)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  createdBy     String?
  updatedBy     String?

  @@index([agentId])
  @@index([status])
  @@index([createdAt])
}

model DocumentRequirement {
  id           String   @id @default(uuid())
  documentName String
  documentKey  String
  isRequired   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  updatedBy    String?
  isDeleted    Boolean  @default(false)
  degreeType   String

  @@unique([degreeType, documentKey])
  @@index([degreeType])
  @@index([isDeleted])
}

model Configuration {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?
}

model ScholarshipRule {
  id                 String                  @id @default(uuid())
  name               String
  minPercentile      Float
  discountPercentage Float
  totalSlots         Int
  filledSlots        Int                     @default(0)
  degreeType         String?
  isActive           Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  allocations        ScholarshipAllocation[]
  eligibleStudents   Student[]
}

model ScholarshipAllocation {
  id         String            @id @default(uuid())
  studentId  String            @unique
  ruleId     String
  status     ScholarshipStatus @default(RESERVED)
  reservedAt DateTime          @default(now())
  lockedAt   DateTime?
  expiresAt  DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  rule       ScholarshipRule   @relation(fields: [ruleId], references: [id])
  student    Student           @relation(fields: [studentId], references: [id])

  @@index([status])
  @@index([expiresAt])
}

model QualificationRequirement {
  id                String   @id @default(uuid())
  degreeType        String
  ruleType          String   @default("SINGLE")
  qualificationKeys String[]
  isRequired        Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?
  updatedBy         String?
  isDeleted         Boolean  @default(false)

  @@index([degreeType])
  @@index([isDeleted])
}

