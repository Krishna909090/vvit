model WaitingList {
  id             String            @id @default(dbgenerated("gen_random_uuid()"))
  studentId      String
  courseId       String
  academicYearId String
  priority       Int               @default(0)
  // Fixed waiting-list token assigned at join time as MAX(waitingNumber)+1
  // within the (courseId, academicYearId) queue. Stable for life — it does NOT
  // shift when entries ahead are allotted/cancelled (live rank is computed
  // separately in getWaitingList). Gaps are expected after allot/cancel.
  waitingNumber  Int               @default(0)
  // Quota the student is queued under. Drives list ordering: MANAGEMENT is
  // ranked by total amount paid (desc), POLICE/GENERAL by waitingNumber (rank).
  // Required at the API layer; default GENERAL only backfills pre-existing rows.
  category       WaitingListCategory @default(GENERAL)
  status         WaitingListStatus @default(WAITING)
  remarks        String?
  allottedAt     DateTime?
  allottedBy     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdBy      String?
  updatedBy      String?
  student        Student           @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course         Course            @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear   AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // NOTE: no unique on (studentId, courseId, academicYearId) — that would count
  // CANCELLED rows and block a student from re-joining a course they withdrew
  // from. "One active course per student per year" is enforced in
  // addToWaitingList (checks for an existing WAITING entry).
  // One number per course-queue per year (safety net for the atomic MAX+1).
  @@unique([courseId, academicYearId, waitingNumber])
  @@index([studentId])
  @@index([courseId, status])
  @@index([courseId, status, category])
  @@index([academicYearId])
}

