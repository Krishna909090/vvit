model Payment {
  id              String            @id @default(dbgenerated("gen_random_uuid()"))
  studentId       String
  amount          Float
  currency        String?           @default("INR")
  status          PaymentStatus?    @default(PENDING)
  mode            PaymentMode?      @default(ONLINE)
  method_legacy   String?
  /// De-duplication key set at Payment.create. Unique at DB level so concurrent webhooks
  /// or accidental double-submits fail with P2002 instead of creating phantom rows.
  /// Convention: providerTxId for online, referenceNumber for offline non-CASH, fallback to id.
  idempotencyKey  String?           @unique
  providerTxId    String?
  merchantOrderId String?
  signature       String?
  referenceNumber String?
  bankName        String?
  branchName      String?
  instrumentDate  DateTime?
  collectedBy     String?
  component       PaymentComponent
  metadata        Json?
  invoiceUrl      String?
  feeDemandId     String?
  createdAt       DateTime?         @default(now())
  updatedAt       DateTime          @updatedAt
  createdBy       String?
  updatedBy       String?
  method          PaymentMethod?
  feeHeadId       String?
  academicYearId  String?
  yearOfStudy     Int?
  isDeleted       Boolean?          @default(false)
  deletedAt       DateTime?
  deletedBy       String?
  feeDemand       StudentFeeDemand? @relation(fields: [feeDemandId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear    AcademicYear?     @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feeHead         FeeHead?          @relation(fields: [feeHeadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student         Student           @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([studentId])
  @@index([status])
  @@index([studentId, status])
  @@index([studentId, component])
  @@index([providerTxId])
  @@index([feeDemandId])
  @@index([createdAt])
}

