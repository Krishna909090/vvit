// ============================================================================
// ADMISSION STATUS LIFECYCLE ENUM (Final Enterprise-Grade)
// ============================================================================
// Defines the complete student admission journey from application to enrollment
// Supports: Management Quota (EXAM) and Convenor Quota (DIRECT qualification)
// ERP Access: Granted ONLY at ADMISSION_CONFIRMED or ENROLLED (NO EXCEPTIONS)
// See: src/types/admissionStatus.ts for complete documentation
// ============================================================================

enum AdmissionStatus {
  // PHASE 1: APPLICATION (Portal)
  REGISTERED                  // Initial registration complete
  ENTRANCE_FEE_PAID           // Entrance/exam fee paid
  EXAM_SCHEDULED              // Exam slot booked (EXAM mode only)
  EXAM_ATTENDED               // Attended exam (EXAM mode only)
  EXAM_QUALIFIED              // Qualified (via exam OR direct admission)
  EXAM_NOT_QUALIFIED          // Failed to qualify
  
  // PHASE 2: DOCUMENT VERIFICATION (Portal ONLY - NOT ERP)
  DOCUMENTS_PENDING           // Awaiting document upload
  DOCUMENTS_SUBMITTED         // Documents uploaded, awaiting admin verification
  DOCUMENTS_VERIFIED          // Admin verified documents in ERP
  
  // PHASE 3: ADMISSION CONFIRMATION (ERP)
  SEAT_ALLOTTED               // Seat allocated, admission number assigned
  ADMISSION_CONFIRMED         // Token fee paid, admission confirmed
                              // ⚠️ ERP ACCESS GRANTED FROM HERE ⚠️
  
  // PHASE 4: ENROLLMENT (University assigns roll number)
  ENROLLED                    // Roll number assigned, academic lifecycle begins
  
  // TERMINAL STATES
  REJECTED                    // Application rejected (terminal)
  CANCELLED                   // Application/admission cancelled (terminal)
}

// ============================================================================
// QUALIFICATION MODE (How student qualified for admission)
// ============================================================================

enum QualificationMode {
  EXAM                        // Qualified via entrance examination
  DIRECT                      // Direct admission (convenor quota, transfer, etc.)
}

// ============================================================================
// ENROLLMENT STATUS (Academic Lifecycle - Separate from Admission)
// ============================================================================

enum EnrollmentStatus {
  ACTIVE                      // Currently enrolled and attending
  SUSPENDED                   // Temporarily suspended (academic/disciplinary)
  DROPPED                     // Dropped out / Discontinued
  COMPLETED                   // Graduated / Program completed
}

