model User {
  id        String    @id @default(uuid())
  name      String?
  email     String?   @unique
  phone     String    @unique
  password  String?   // For Admins/Staff
  role      Role      @default(STUDENT)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?

  otps UserOtp[]

  studentProfile    Student?           @relation("StudentUser")
  agentStudents     Student[]          @relation("AgentStudents")
  agentCommissions  AgentCommission[]
  adminActivityLogs AdminActivityLog[]
  notifications     Notification[]
  
  customRoleId String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id])
  auditLogs    AuditLog[]
  isDeleted Boolean @default(false)

  @@index([role])
  @@index([createdAt])
  @@index([isDeleted])
}

model UserOtp {
  id          String   @id @default(uuid())
  userId      String
  type        String   // e.g. "LOGIN", "PASSWORD_RESET"
  otpHash     String
  expiresAt   DateTime
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type, used, expiresAt])
}




model School {
  id        String   @id @default(uuid())
  name      String   @unique // e.g. "School of Management"
  code      String   @unique // e.g. "SOM"
  
  departments Department[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([isDeleted])
}

model Department {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String    @unique 
  courses   Course[]

  schoolId  String?
  school    School?   @relation(fields: [schoolId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean @default(false)

  @@index([isDeleted])
}

// Course model updated
model Course {
  id            String         @id @default(uuid())
  code          String         @unique 
  name          String 
  degree        String?        // e.g. "B.Tech", "M.Tech"
  departmentId  String
  department    Department     @relation(fields: [departmentId], references: [id])
  specializations      Specialization[]
  feeStructures FeeStructure[]
