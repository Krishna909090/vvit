generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()"))
  name                String?
  email               String?                  @unique
  phone               String?                  @unique
  role                String?
  createdAt           DateTime?                @default(now())
  updatedAt           DateTime                 @updatedAt
  createdBy           String?
  updatedBy           String?
  isDeleted           Boolean?                 @default(false)
  password            String?
  agentCommissions    AgentCommission[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  agentStudents       Student[]                @relation("AgentStudents")
  studentProfile      Student?                 @relation("StudentUser")
  userGroups          UserGroup[]
  otps                UserOtp[]
  permissionOverrides UserPermissionOverride[]
}

model UserOtp {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  userId      String
  type        String
  otpHash     String
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  used        Boolean?  @default(false)
  createdAt   DateTime? @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  user        User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model School {
  id          String       @id @default(dbgenerated("gen_random_uuid()"))
  name        String
  code        String
  createdAt   DateTime?    @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   String?
  updatedBy   String?
  isDeleted   Boolean?     @default(false)
  departments Department[]
}

model Department {
  id        String    @id @default(dbgenerated("gen_random_uuid()"))
  name      String
  code      String
  schoolId  String?
  createdAt DateTime? @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean?  @default(false)
  courses   Course[]
  school    School?   @relation(fields: [schoolId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Course {
  id               String             @id @default(dbgenerated("gen_random_uuid()"))
  code             String?
  name             String
  departmentId     String
  createdAt        DateTime?          @default(now())
  updatedAt        DateTime           @updatedAt
  createdBy        String?
  updatedBy        String?
  isDeleted        Boolean?           @default(false)
  degree           String?
  filledSeats      Int?               @default(0)
  totalSeats       Int?               @default(0)
  department       Department         @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feeStructures    FeeStructure[]
  specializations  Specialization[]
  studentsPref1    Student[]          @relation("Pref1")
  studentsPref2    Student[]          @relation("Pref2")
  studentsPref3    Student[]          @relation("Pref3")
  allottedStudents StudentAdmission[] @relation("AllottedCourse")
}

model Batch {
  id               String         @id @default(dbgenerated("gen_random_uuid()"))
  name             String
  startDate        DateTime
  endDate          DateTime
  courseId         String
  specializationId String
  createdAt        DateTime?      @default(now())
  updatedAt        DateTime       @updatedAt
  createdBy        String?
  updatedBy        String?
  isDeleted        Boolean?       @default(false)
  specialization   Specialization @relation(fields: [specializationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sections         Section[]
}

model Section {
  id        String              @id @default(dbgenerated("gen_random_uuid()"))
  name      String
  batchId   String
  createdAt DateTime?           @default(now())
  updatedAt DateTime            @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean?            @default(false)
  batch     Batch               @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students  StudentEnrollment[]
}

model AcademicYear {
  id                String              @id @default(dbgenerated("gen_random_uuid()"))
  code              String
  startDate         DateTime
  endDate           DateTime
  isActive          Boolean?            @default(true)
  isLocked          Boolean?            @default(false)
  createdAt         DateTime?           @default(now())
  updatedAt         DateTime            @updatedAt
  createdBy         String?
  updatedBy         String?
  isDeleted         Boolean?            @default(false)
  feeStructures     FeeStructure[]
  studentAdmissions StudentAdmission[]
  enrollments       StudentEnrollment[]
  studentFeeDemands StudentFeeDemand[]
}

model StudentEnrollment {
  id              String            @id @default(dbgenerated("gen_random_uuid()"))
  studentId       String            @unique
  sectionId       String
  rollNumber      String            @unique
  currentSemester Int?              @default(1)
  academicYearId  String
  status          EnrollmentStatus? @default(ACTIVE)
  createdAt       DateTime?         @default(now())
  updatedAt       DateTime          @updatedAt
  createdBy       String?
  updatedBy       String?
  academicYear    AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  section         Section           @relation(fields: [sectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student         Student           @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Student {
  id                        String                  @id @default(dbgenerated("gen_random_uuid()"))
  applicationId             String?                 @unique
  name                      String
  fatherName                String
  motherName                String
  gender                    String
  dob                       DateTime
  phone                     String
  email                     String?                 @unique
  aadharNumber              String
  category                  String
  country                   String
  address                   String
  address2                  String?
  city                      String
  state                     String
  pincode                   String
  profilePhotoUrl           String?
  documentFolderPath        String?
  source                    AdmissionSource?        @default(WEBSITE)
  quotaType                 QuotaType?              @default(MANAGEMENT)
  applicationMode           ApplicationMode?        @default(ONLINE)
  isOffline                 Boolean?                @default(false)
  isKycVerified             Boolean?                @default(false)
  pref1                     String?
  pref2                     String?
  pref3                     String?
  userId                    String?                 @unique
  agentId                   String?
  eligibleScholarshipRuleId String?
  degreeType                String?
  courseType                String?
  scholarshipRemarks        String?
  scholarshipVerified       Boolean?                @default(false)
  scholarshipVerifiedAt     DateTime?
  scholarshipVerifiedBy     String?
  createdAt                 DateTime?               @default(now())
  updatedAt                 DateTime                @updatedAt
  createdBy                 String?
  updatedBy                 String?
  academicQualifications    AcademicQualification[]
  agentCommissions          AgentCommission[]
  attendanceRecords         AttendanceRecord[]
  cancellationRequests      CancellationRequest[]
  convenorDetails           ConvenorAdmission?
  courseChangeLogs          CourseChangeLog[]
  courseChangeRequests      CourseChangeRequest[]
  discountRequests          DiscountRequest[]
  fileUploads               FileUpload[]
  hallTickets               HallTicket[]
  hostelAllocation          HostelAllocation?
  payments                  Payment[]
  scholarshipAllocation     ScholarshipAllocation?
  seatAllocations           SeatAllocation[]
  serviceChangeRequests     ServiceChangeRequest[]
  agent                     User?                   @relation("AgentStudents", fields: [agentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  eligibleScholarshipRule   ScholarshipRule?        @relation(fields: [eligibleScholarshipRuleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pref1Course               Course?                 @relation("Pref1", fields: [pref1], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pref2Course               Course?                 @relation("Pref2", fields: [pref2], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pref3Course               Course?                 @relation("Pref3", fields: [pref3], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                      User?                   @relation("StudentUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  admissionDetails          StudentAdmission?
  documents                 StudentDocument[]
  enrollment                StudentEnrollment?
  examDetails               StudentExam?
  feeDemands                StudentFeeDemand[]
  ledgerEntries             StudentLedger[]
  studentScholarship        StudentScholarship?
  transportAllocation       TransportAllocation?
}

model ConvenorAdmission {
  id             String    @id @default(dbgenerated("gen_random_uuid()"))
  studentId      String    @unique
  rank           String?
  hallTicketNo   String?
  allotmentOrder String?
  councilId      String?
  category       String?
  joiningReport  String?
  createdAt      DateTime? @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  student        Student   @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model DataImportMapping {
  id        String     @id @default(dbgenerated("gen_random_uuid()"))
  name      String     @unique
  type      ImportType
  mapping   Json
  isActive  Boolean?   @default(true)
  createdAt DateTime?  @default(now())
  updatedAt DateTime   @updatedAt
  createdBy String?
  updatedBy String?
}

model StudentExam {
  id               String    @id @default(dbgenerated("gen_random_uuid()"))
  studentId        String    @unique
  hallTicketUrl    String?
  testDate         DateTime?
  testCenter       String?
  examAttended     Boolean?  @default(false)
  examScore        Float?
  isQualified      Boolean?  @default(false)
  examSlotId       String?
  class12Aggregate Float?
  jeePercentile    Float?
  satScore         Float?
  vvitPercentile   Float?
  createdAt        DateTime? @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?
  examSlot         ExamSlot? @relation(fields: [examSlotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student          Student   @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model StudentAdmission {
  id                String             @id @default(dbgenerated("gen_random_uuid()"))
  studentId         String             @unique
  status            AdmissionStatus?   @default(REGISTERED)
  qualificationMode QualificationMode?
  totalFee          Float?             @default(0)
  paidFee           Float?             @default(0)
  feeStatus         FeeStatus?         @default(PENDING)
  accommodationType AccommodationType? @default(NONE)
  hostelType        HostelType?
  hostelId          String?
  transportRouteId  String?
  roomNumber        String?
  allottedCourseId  String?
  createdAt         DateTime?          @default(now())
  updatedAt         DateTime           @updatedAt
  hostelPaymentMode HostelPaymentMode? @default(YEARWISE)
  academicYearId    String?
  academicYear      AcademicYear?      @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  allottedCourse    Course?            @relation("AllottedCourse", fields: [allottedCourseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hostel            Hostel?            @relation(fields: [hostelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student           Student            @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transportRoute    TransportRoute?    @relation(fields: [transportRouteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model StudentDocument {
  id          String                 @id @default(dbgenerated("gen_random_uuid()"))
  studentId   String
  documentKey String
  url         String
  status      StudentDocumentStatus? @default(PENDING)
  remarks     String?
  isDeleted   Boolean?               @default(false)
  createdAt   DateTime?              @default(now())
  updatedAt   DateTime               @updatedAt
  createdBy   String?
  updatedBy   String?
  student     Student                @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([studentId, documentKey])
}

model Specialization {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  code        String?
  name        String
  courseId    String
  totalSeats  Int
  filledSeats Int?      @default(0)
  createdAt   DateTime? @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  isDeleted   Boolean?  @default(false)
  batches     Batch[]
  course      Course    @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Hostel {
  id                String             @id @default(dbgenerated("gen_random_uuid()"))
  name              String
  type              String?
  wardenName        String?
  capacity          Int
  filled            Int?               @default(0)
  blockName         String?
  roomNumber        String?
  isDeleted         Boolean?           @default(false)
  cost              Float?             @default(0)
  createdAt         DateTime?          @default(now())
  updatedAt         DateTime           @updatedAt
  createdBy         String?
  updatedBy         String?
  accommodationCost Float?             @default(0)
  messCost          Float?             @default(0)
  blocks            HostelBlock[]
  studentAdmissions StudentAdmission[]
}

model HostelBlock {
  id        String       @id @default(dbgenerated("gen_random_uuid()"))
  hostelId  String
  name      String
  type      String
  createdAt DateTime?    @default(now())
  updatedAt DateTime     @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean?     @default(false)
  hostel    Hostel       @relation(fields: [hostelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rooms     HostelRoom[]
}

model HostelRoom {
  id                String      @id @default(dbgenerated("gen_random_uuid()"))
  blockId           String
  number            String
  capacity          Int
  type              String
  cost              Float?      @default(0)
  createdAt         DateTime?   @default(now())
  updatedAt         DateTime    @updatedAt
  createdBy         String?
  updatedBy         String?
  isDeleted         Boolean?    @default(false)
  accommodationCost Float?      @default(0)
  messCost          Float?      @default(0)
  beds              HostelBed[]
  block             HostelBlock @relation(fields: [blockId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model HostelPriceCategory {
  id                 String         @id @default(dbgenerated("gen_random_uuid()"))
  sharing            Int
  roomType           HostelRoomType
  price              Float
  createdAt          DateTime?      @default(now())
  updatedAt          DateTime       @updatedAt
  createdBy          String?
  updatedBy          String?
  metadata           Json?
  accommodationPrice Float?         @default(0)
  messPrice          Float?         @default(0)

  @@unique([sharing, roomType])
}

model HostelBed {
  id         String            @id @default(dbgenerated("gen_random_uuid()"))
  roomId     String
  number     String
  isOccupied Boolean?          @default(false)
  createdAt  DateTime?         @default(now())
  updatedAt  DateTime          @updatedAt
  createdBy  String?
  updatedBy  String?
  allocation HostelAllocation?
  room       HostelRoom        @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model HostelAllocation {
  id        String                  @id @default(dbgenerated("gen_random_uuid()"))
  studentId String                  @unique
  bedId     String                  @unique
  startDate DateTime
  endDate   DateTime?
  status    HostelAllocationStatus? @default(ACTIVE)
  createdAt DateTime?               @default(now())
  updatedAt DateTime                @updatedAt
  createdBy String?
  updatedBy String?
  bed       HostelBed               @relation(fields: [bedId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student   Student                 @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Vehicle {
  id          String           @id @default(dbgenerated("gen_random_uuid()"))
  number      String           @unique
  capacity    Int
  driverName  String
  driverPhone String
  isDeleted   Boolean?         @default(false)
  createdAt   DateTime?        @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   String?
  updatedBy   String?
  routes      TransportRoute[]
}

model TransportRoute {
  id                String                @id @default(dbgenerated("gen_random_uuid()"))
  name              String
  cost              Float
  city              String?
  busNumber         String?
  capacity          Int?                  @default(0)
  filled            Int?                  @default(0)
  vehicleId         String?
  isDeleted         Boolean?              @default(false)
  createdAt         DateTime?             @default(now())
  updatedAt         DateTime              @updatedAt
  createdBy         String?
  updatedBy         String?
  studentAdmissions StudentAdmission[]
  allocations       TransportAllocation[]
  vehicle           Vehicle?              @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stops             TransportStop[]
}

model TransportStop {
  id          String                @id @default(dbgenerated("gen_random_uuid()"))
  routeId     String
  name        String
  sequence    Int
  pickupTime  DateTime
  dropTime    DateTime
  isDeleted   Boolean?              @default(false)
  createdAt   DateTime?             @default(now())
  updatedAt   DateTime              @updatedAt
  createdBy   String?
  updatedBy   String?
  allocations TransportAllocation[]
  route       TransportRoute        @relation(fields: [routeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model TransportAllocation {
  id        String                     @id @default(dbgenerated("gen_random_uuid()"))
  studentId String                     @unique
  routeId   String
  stopId    String
  startDate DateTime
  endDate   DateTime?
  status    TransportAllocationStatus? @default(ACTIVE)
  createdAt DateTime?                  @default(now())
  updatedAt DateTime                   @updatedAt
  createdBy String?
  updatedBy String?
  route     TransportRoute             @relation(fields: [routeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stop      TransportStop              @relation(fields: [stopId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student   Student                    @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model FeeHead {
  id                String             @id @default(dbgenerated("gen_random_uuid()"))
  name              String
  description       String?
  isDeleted         Boolean?           @default(false)
  createdAt         DateTime?          @default(now())
  updatedAt         DateTime           @updatedAt
  createdBy         String?
  updatedBy         String?
  structures        FeeStructure[]
  payments          Payment[]
  studentFeeDemands StudentFeeDemand[]
}

model FeeStructure {
  id             String             @id @default(dbgenerated("gen_random_uuid()"))
  courseId       String
  feeHeadId      String
  amount         Float
  currency       String?            @default("INR")
  academicYearId String
  quotaType      QuotaType?
  courseType     String?
  dueDate        DateTime?
  yearOfStudy    Int?
  degreeId       String?
  isDeleted      Boolean?           @default(false)
  createdAt      DateTime?          @default(now())
  updatedAt      DateTime           @updatedAt
  createdBy      String?
  updatedBy      String?
  academicYear   AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course         Course             @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feeHead        FeeHead            @relation(fields: [feeHeadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  demands        StudentFeeDemand[]
}

model StudentFeeDemand {
  id                String        @id @default(dbgenerated("gen_random_uuid()"))
  studentId         String
  feeStructureId    String?
  amount            Float
  dueDate           DateTime
  status            FeeStatus
  createdAt         DateTime?     @default(now())
  updatedAt         DateTime      @updatedAt
  createdBy         String?
  updatedBy         String?
  discountAmount    Float         @default(0)
  fineAmount        Float         @default(0)
  remarks           String?
  netAmount         Float?
  scholarshipAmount Float         @default(0)
  academicYearId    String?
  feeHeadId         String?
  payments          Payment[]
  academicYear      AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feeHead           FeeHead?      @relation(fields: [feeHeadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feeStructure      FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student           Student       @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Payment {
  id              String            @id @default(dbgenerated("gen_random_uuid()"))
  studentId       String
  amount          Float
  currency        String?           @default("INR")
  status          PaymentStatus?    @default(PENDING)
  mode            PaymentMode?      @default(ONLINE)
  method_legacy   String?
  providerTxId    String?
  merchantOrderId String?
  signature       String?
  referenceNumber String?
  bankName        String?
  branchName      String?
  instrumentDate  DateTime?
  collectedBy     String?
  component       PaymentComponent
  metadata        Json?
  invoiceUrl      String?
  feeDemandId     String?
  createdAt       DateTime?         @default(now())
  updatedAt       DateTime          @updatedAt
  createdBy       String?
  updatedBy       String?
  method          PaymentMethod?
  feeHeadId       String?
  feeDemand       StudentFeeDemand? @relation(fields: [feeDemandId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feeHead         FeeHead?          @relation(fields: [feeHeadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student         Student           @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model CourseChangeLog {
  id         String    @id @default(dbgenerated("gen_random_uuid()"))
  studentId  String
  oldCourse  String
  newCourse  String
  oldDegree  String?
  newDegree  String?
  approvedBy String
  date       DateTime? @default(now())
  createdBy  String?
  updatedBy  String?
  student    Student   @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model DiscountRequest {
  id              String          @id @default(dbgenerated("gen_random_uuid()"))
  studentId       String
  reason          String
  documentUrl     String?
  status          DiscountStatus? @default(REQUESTED)
  remarks         String?
  requestedAmount Float?          @default(0)
  approvedAmount  Float?
  approvedAt      DateTime?
  approvedBy      String?
  component       String?
  createdAt       DateTime?       @default(now())
  updatedAt       DateTime        @updatedAt
  createdBy       String?
  updatedBy       String?
  items           Json?
  student         Student         @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  isLocked    Boolean? @default(false)
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

model AuditLog {
  id        String    @id @default(dbgenerated("gen_random_uuid()"))
  userId    String?
  action    String
  entity    String
  entityId  String?
  timestamp DateTime? @default(now())
  details   Json?
  ipAddress String?
  userAgent String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model CancellationRequest {
  id           String              @id @default(dbgenerated("gen_random_uuid()"))
  studentId    String
  reason       String
  refundAmount Float?
  status       CancellationStatus? @default(REQUESTED)
  approvedBy   String?
  createdAt    DateTime?           @default(now())
  updatedAt    DateTime            @updatedAt
  createdBy    String?
  updatedBy    String?
  student      Student             @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model FileUpload {
  id         String    @id @default(dbgenerated("gen_random_uuid()"))
  studentId  String?
  uploadedBy String?
  url        String
  kind       FileKind
  fileName   String?
  mime       String?
  size       Int?
  metadata   Json?
  createdAt  DateTime? @default(now())
  updatedAt  DateTime  @updatedAt
  createdBy  String?
  updatedBy  String?
  student    Student?  @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ExamDate {
  id                String             @id @default(dbgenerated("gen_random_uuid()"))
  name              String?
  date              DateTime
  startTime         DateTime?
  endTime           DateTime?
  createdAt         DateTime?          @default(now())
  updatedAt         DateTime           @updatedAt
  createdBy         String?
  updatedBy         String?
  attendanceRecords AttendanceRecord[]
}

model ExamCenter {
  id        String     @id @default(dbgenerated("gen_random_uuid()"))
  name      String
  address   String?
  city      String?
  capacity  Int?
  isDeleted Boolean?   @default(false)
  createdAt DateTime?  @default(now())
  updatedAt DateTime   @updatedAt
  createdBy String?
  updatedBy String?
  examSlots ExamSlot[]
}

model ExamSlot {
  id               String        @id @default(dbgenerated("gen_random_uuid()"))
  examCenterId     String
  date             DateTime
  startTime        DateTime
  endTime          DateTime
  capacity         Int
  filled           Int?          @default(0)
  isBookingEnabled Boolean?      @default(false)
  isDeleted        Boolean?      @default(false)
  createdAt        DateTime?     @default(now())
  updatedAt        DateTime      @updatedAt
  createdBy        String?
  updatedBy        String?
  examCenter       ExamCenter    @relation(fields: [examCenterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  studentExams     StudentExam[]
}

model HallTicket {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  studentId   String
  fileId      String?
  url         String?
  qrHash      String?
  generatedAt DateTime? @default(now())
  createdBy   String?
  updatedBy   String?
  student     Student   @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model InvigilatorCredential {
  id         String    @id @default(dbgenerated("gen_random_uuid()"))
  adminId    String
  token      String
  validFrom  DateTime
  validUntil DateTime
  createdAt  DateTime? @default(now())
  createdBy  String?
  updatedBy  String?
}

model AttendanceRecord {
  id            String    @id @default(dbgenerated("gen_random_uuid()"))
  studentId     String
  examDateId    String?
  invigilatorId String?
  scannedAt     DateTime? @default(now())
  verified      Boolean?  @default(false)
  verifiedAt    DateTime?
  createdAt     DateTime? @default(now())
  createdBy     String?
  updatedBy     String?
  examDate      ExamDate? @relation(fields: [examDateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student       Student   @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model SeatAllocation {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  studentId   String
  oldCourse   String?
  newCourse   String?
  allocatedBy String?
  allocatedAt DateTime? @default(now())
  notes       String?
  createdBy   String?
  updatedBy   String?
  student     Student   @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model CourseChangeRequest {
  id          String         @id @default(dbgenerated("gen_random_uuid()"))
  studentId   String
  fromCourse  String
  toCourse    String
  fromDegree  String?
  toDegree    String?
  reason      String
  status      RequestStatus? @default(REQUESTED)
  forwardedTo String?
  actionedBy  String?
  actionedAt  DateTime?
  createdAt   DateTime?      @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   String?
  updatedBy   String?
  student     Student        @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model AgentCommission {
  id        String                 @id @default(dbgenerated("gen_random_uuid()"))
  agentId   String
  studentId String
  amount    Float
  component String
  status    AgentCommissionStatus? @default(PENDING)
  createdAt DateTime?              @default(now())
  createdBy String?
  updatedBy String?
  agent     User                   @relation(fields: [agentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student   Student                @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Notification {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  recipientId String
  type        String
  title       String
  body        String
  link        String?
  isRead      Boolean?  @default(false)
  createdAt   DateTime? @default(now())
  createdBy   String?
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model OfflineUploadBatch {
  id            String                    @id @default(dbgenerated("gen_random_uuid()"))
  agentId       String?
  uploadedBy    String?
  sourceFileUrl String?
  status        OfflineUploadBatchStatus? @default(PENDING)
  createdAt     DateTime?                 @default(now())
  updatedAt     DateTime                  @updatedAt
  createdBy     String?
  updatedBy     String?
}

model DocumentRequirement {
  id           String    @id @default(dbgenerated("gen_random_uuid()"))
  documentName String
  documentKey  String
  isRequired   Boolean?  @default(true)
  degreeType   String
  isDeleted    Boolean?  @default(false)
  createdAt    DateTime? @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?

  @@unique([degreeType, documentKey])
}

model ScholarshipRule {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()"))
  name               String
  minPercentile      Float
  discountPercentage Float
  totalSlots         Int
  filledSlots        Int                     @default(0)
  degreeType         String?
  isActive           Boolean?                @default(true)
  createdAt          DateTime?               @default(now())
  updatedAt          DateTime                @updatedAt
  allocations        ScholarshipAllocation[]
  eligibleStudents   Student[]
}

model QualificationRequirement {
  id                String    @id @default(dbgenerated("gen_random_uuid()"))
  degreeType        String
  ruleType          String?   @default("SINGLE")
  qualificationKeys String[]
  isRequired        Boolean?  @default(true)
  isDeleted         Boolean?  @default(false)
  createdAt         DateTime? @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String?
  updatedBy         String?
}

model Group {
  id        String      @id @default(dbgenerated("gen_random_uuid()"))
  name      String      @unique
  type      String
  createdAt DateTime?   @default(now())
  updatedAt DateTime    @updatedAt
  roles     GroupRole[]
  users     UserGroup[]
}

model GroupRole {
  groupId    String
  roleId     String
  assignedAt DateTime? @default(now())
  group      Group     @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([groupId, roleId])
}

model Module {
  id          String       @id @default(dbgenerated("gen_random_uuid()"))
  name        String
  code        String       @unique
  createdAt   DateTime?    @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]
}

model Permission {
  id          String                   @id @default(dbgenerated("gen_random_uuid()"))
  key         String                   @unique
  description String?
  moduleId    String
  createdAt   DateTime?                @default(now())
  updatedAt   DateTime                 @updatedAt
  module      Module                   @relation(fields: [moduleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roles       RolePermission[]
  overrides   UserPermissionOverride[]
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()"))
  name        String           @unique
  description String?
  createdAt   DateTime?        @default(now())
  updatedAt   DateTime         @updatedAt
  groups      GroupRole[]
  permissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime?  @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([roleId, permissionId])
}

model UserGroup {
  userId     String
  groupId    String
  assignedAt DateTime? @default(now())
  group      Group     @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, groupId])
}

model UserPermissionOverride {
  userId       String
  permissionId String
  type         OverrideType
  createdAt    DateTime?    @default(now())
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user         User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, permissionId])
}

model AcademicQualification {
  id                  String               @id @default(dbgenerated("gen_random_uuid()"))
  studentId           String
  level               String
  board               String
  yearOfPassing       String
  percentage          Float?
  docUrl              String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  createdBy           String?
  gpaOrMarks          String?
  hallTicketNumber    String?
  schoolName          String?
  updatedBy           String?
  verificationStatus  String?              @default("PENDING")
