model ScholarshipAllocation {
  id         String            @id @default(dbgenerated("gen_random_uuid()"))
  studentId  String            @unique
  ruleId     String
  status     ScholarshipStatus @default(RESERVED)
  expiresAt  DateTime?
  reservedAt DateTime?
