model FeeHead {
  id          String         @id @default(uuid())
  name        String 
  description String?
  structures  FeeStructure[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   String?
  updatedBy   String?
  isDeleted   Boolean  @default(false)

