model PRO {
  id        String  @id @default(dbgenerated("gen_random_uuid()"))
  proNumber String  @unique
  name      String?
  phone     String?
  email     String?
  userId    String? @unique

  createdAt DateTime? @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?

  user     User?     @relation("ProUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students Student[]
}

// Subject — curriculum unit offered by (Course, Semester).
// One row per subject in the course catalog.
model Subject {
  id                String           @id @default(dbgenerated("gen_random_uuid()"))
  code              String
  name              String
  courseId          String
  semester          Int
  credits           Float            @default(0)
  examType          SubjectExamType  @default(THEORY)
  maxInternalMarks  Float?           @default(30)
  maxExternalMarks  Float?           @default(70)
  maxTotalMarks     Float?           @default(100)
  isElective        Boolean          @default(false)
  isDeleted         Boolean?         @default(false)
  createdAt         DateTime?        @default(now())
  updatedAt         DateTime         @updatedAt
  createdBy         String?
  updatedBy         String?
  course            Course           @relation(fields: [courseId],         references: [id], onDelete: NoAction, onUpdate: NoAction)
  marks             SemesterMark[]
  classAttendance   ClassAttendance[]

  @@unique([courseId, semester, code])
  @@index([courseId, semester])
}

// SemesterMark — student's marks for a (subject, academicYear, attempt).
// attemptNumber: 1=regular, 2..=supplementary/reval (new row per attempt, history preserved).
// status=PENDING allowed with grade=null (subject exists, marks not yet entered).
// Non-PENDING statuses require a grade string (admin-entered; service does not auto-compute).
// isBackfilled=true flags retroactive entries for audit reports.
model SemesterMark {
  id                String              @id @default(dbgenerated("gen_random_uuid()"))
  studentId         String
  subjectId         String
  academicYearId    String
  semester          Int
  internalMarks     Float?
  externalMarks     Float?
  totalMarks        Float?
  grade             String?
  gradePoints       Float?
  status            SemesterMarkStatus  @default(PENDING)
  attemptNumber     Int                 @default(1)
  isSupplementary   Boolean             @default(false)
  remarks           String?
  isBackfilled      Boolean?            @default(false)
  isDeleted         Boolean?            @default(false)
  createdAt         DateTime?           @default(now())
  updatedAt         DateTime            @updatedAt
  createdBy         String?
  updatedBy         String?
  student           Student             @relation(fields: [studentId],      references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject           Subject             @relation(fields: [subjectId],      references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear      AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([studentId, subjectId, academicYearId, attemptNumber], name: "SemesterMark_unique_per_attempt")
  @@index([studentId, semester])
  @@index([studentId, academicYearId])
  @@index([academicYearId, semester])
  @@index([subjectId, academicYearId])
}

enum SubjectExamType {
  THEORY
  PRACTICAL
  PROJECT
  INTERNSHIP
  SEMINAR
}

enum SemesterMarkStatus {
  PENDING
  PASS
  FAIL
  ABSENT
  WITHHELD
  PROMOTED
}

// ClassAttendance — one row per (student, subject, date, period?). When periodNumber
// is null, the row represents day-level attendance (one row per day). When set,
// represents period-/hour-level attendance (multiple rows per day per subject).
// Mirrors the marks design: same back-fill safeguards, same enrollment gate.
model ClassAttendance {
  id              String           @id @default(dbgenerated("gen_random_uuid()"))
  studentId       String
  subjectId       String
  academicYearId  String
  semester        Int
  date            DateTime         // class date — store at midnight UTC for date-only semantics
  periodNumber    Int?             // null = day-level row; non-null = period-/hour-level
  status          AttendanceStatus
  remarks         String?
  markedBy        String?          // userId of the marker (faculty/admin)
  isBackfilled    Boolean?         @default(false)
  isDeleted       Boolean?         @default(false)
  createdAt       DateTime?        @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       String?
  updatedBy       String?
  student         Student          @relation(fields: [studentId],      references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject         Subject          @relation(fields: [subjectId],      references: [id], onDelete: NoAction, onUpdate: NoAction)
  academicYear    AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([studentId, subjectId, date, periodNumber], name: "ClassAttendance_unique_slot")
  @@index([studentId, date])
  @@index([subjectId, date])
  @@index([academicYearId, semester, date])
  @@index([studentId, subjectId, academicYearId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  ON_DUTY      // OD — institutional events, sports, etc. — counted as present in some calculations
}
