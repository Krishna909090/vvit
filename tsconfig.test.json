{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["jest", "node"],
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false
  },
  "include": [
    "src/**/*",
    "src/**/__tests__/**/*.ts",
    "src/**/__mocks__/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
